from typing import Generic, Literal, TypeVar

import numpy as np
from numpy.typing import NDArray

from ._modern import TDigest as TDigest

__version__: str

def wire_precision_py(b: bytes) -> Literal["f32", "f64"]: ...

_F = TypeVar("_F", np.float32, np.float64)
_D = TypeVar("_D", bound="_LegacyDigest")

class _LegacyDigest(Generic[_F]):
    @classmethod
    def empty(cls: type[_D]) -> _D: ...
    @classmethod
    def from_array(cls: type[_D], arr: NDArray[_F], delta: float) -> _D: ...
    @classmethod
    def from_means_weights(cls: type[_D], arr: NDArray[_F], weights: NDArray[np.uint32], delta: float) -> _D: ...
    @property
    def means(self) -> NDArray[_F]: ...
    @property
    def weights(self) -> NDArray[np.uint32]: ...
    def __len__(self) -> int: ...
    def n_zero_weights(self) -> int: ...
    def quantile(self, x: float) -> float: ...
    def median(self) -> float: ...
    def trimmed_mean(self, lower: float, upper: float) -> float: ...
    def merge(self: _D, other: _D, delta: float) -> _D: ...
    def cast_f32(self) -> _TDigestInternal32: ...
    def cast_f64(self) -> _TDigestInternal64: ...

class _TDigestInternal32(_LegacyDigest[np.float32]): ...
class _TDigestInternal64(_LegacyDigest[np.float64]): ...
